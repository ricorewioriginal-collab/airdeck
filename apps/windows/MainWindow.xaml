<Window x:Class="AnMaChaCast.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AnMaChaCast.ViewModels"
        Title="AnMaCha Cast" Height="860" Width="1320" MinHeight="620" MinWidth="980"
        Background="#0B1220" Foreground="#E6ECF5" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#162236"/>
            <Setter Property="Foreground" Value="#E6ECF5"/>
            <Setter Property="BorderBrush" Value="#2A3C56"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="3"/>
        </Style>
        <Style TargetType="ToggleButton">
            <Setter Property="Background" Value="#162236"/>
            <Setter Property="Foreground" Value="#E6ECF5"/>
            <Setter Property="BorderBrush" Value="#2A3C56"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="3"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Kopfzeile: Sender, On-Air, Betriebsart, Mikrofon, Sendung, Uhr -->
        <Border Grid.Row="0" Background="#101A2C" CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <DockPanel LastChildFill="False" VerticalAlignment="Center">
                <ComboBox x:Name="StationPicker" DockPanel.Dock="Left" Width="220" Margin="0,0,16,0"
                          DisplayMemberPath="name" SelectionChanged="StationPicker_SelectionChanged"/>

                <Ellipse x:Name="OnAirDot" DockPanel.Dock="Left" Width="14" Height="14" Fill="#555" Margin="0,0,6,0"/>
                <TextBlock x:Name="OnAirText" DockPanel.Dock="Left" Text="OFF AIR" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,20,0"/>

                <ToggleButton x:Name="BtnAuto" DockPanel.Dock="Left" Content="24/7 · AUTO" Click="BtnAuto_Click"/>
                <ToggleButton x:Name="BtnManual" DockPanel.Dock="Left" Content="MANUAL" Margin="0,3,16,3" Click="BtnManual_Click"/>

                <ToggleButton x:Name="BtnMic" DockPanel.Dock="Left" Content="🎙 Mikrofon" Click="BtnMic_Click"/>
                <Button x:Name="BtnStream" DockPanel.Dock="Left" Content="Sendung starten" Click="BtnStream_Click"/>

                <TextBlock x:Name="ClockText" DockPanel.Dock="Right" Text="--:--:--" FontFamily="Consolas"
                           FontSize="20" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Decks A-D -->
        <ItemsControl Grid.Row="1" x:Name="DecksList" Margin="0,0,0,10">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:DeckViewModel}">
                    <Border Background="#101A2C" CornerRadius="6" Margin="4" Padding="10">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Id}" FontWeight="Bold" FontSize="16"
                                           Foreground="#7FB2FF" Width="22"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusLabel}" Foreground="#9FB4D6"/>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <TextBlock Text="{Binding Artist}" Foreground="#9FB4D6" TextTrimming="CharacterEllipsis" Margin="0,2,0,6"/>

                            <ProgressBar Height="6" Minimum="0" Maximum="1" Value="{Binding ProgressFraction, Mode=OneWay}"
                                         Background="#0B1220" Foreground="#4C8DFF" BorderThickness="0"/>
                            <DockPanel Margin="0,2,0,8">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding RemainingLabel}" Foreground="#9FB4D6" FontFamily="Consolas"/>
                            </DockPanel>

                            <UniformGrid Rows="1" Columns="5">
                                <Button Content="⏮10s" Click="DeckSkipBack_Click" ToolTip="10 Sekunden zurück"/>
                                <Button Content="▶" Click="DeckPlay_Click" ToolTip="Abspielen"/>
                                <Button Content="⏸" Click="DeckPause_Click" ToolTip="Pause"/>
                                <Button Content="⏹" Click="DeckStop_Click" ToolTip="Stopp (bereit)"/>
                                <Button Content="10s⏭" Click="DeckSkipFwd_Click" ToolTip="10 Sekunden vor"/>
                            </UniformGrid>

                            <DockPanel Margin="0,6,0,0">
                                <TextBlock DockPanel.Dock="Left" Text="Mon." Foreground="#9FB4D6" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Slider Minimum="0" Maximum="100" Value="{Binding LocalVolume, Mode=TwoWay}"
                                        ToolTip="Nur lokale Monitor-Lautstärke dieses Rechners – die Engine hat keine Pro-Deck-Lautstärke, es wird nichts an den Server gesendet."/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Cardwall -->
        <Border Grid.Row="2" Background="#101A2C" CornerRadius="6" Padding="8">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Text="Cardwall" FontWeight="Bold" Margin="4,0,0,6"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="CartsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CartViewModel}">
                                <Button Width="150" Height="60" Click="Cart_Click" Background="{Binding Color}">
                                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" TextAlignment="Center"
                                               Foreground="White" FontWeight="SemiBold"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Weitere Funktionen (noch WebView2) -->
        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <Button DockPanel.Dock="Left" x:Name="BtnBrowser" Content="Weitere Funktionen im Browser öffnen (Mediathek, Playlists, Sendeplan, Einstellungen, …)"
                    Click="BtnBrowser_Click"/>
            <TextBlock x:Name="StatusText" DockPanel.Dock="Right" Foreground="#9FB4D6" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
