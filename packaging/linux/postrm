#!/bin/sh
# AnMaCha Cast – nach der Entfernung. Deine Daten (Musik, Datenbank, verschlüsselte Passwörter) unter
# /var/lib/anmachacast bleiben absichtlich erhalten, auch bei "apt purge" – wie bei der Windows-Version.
# Selbst entfernen: rm -rf /var/lib/anmachacast /var/log/anmachacast /etc/anmachacast
set -e

if [ -d /run/systemd/system ]; then
  systemctl daemon-reload || true
fi

if [ "$1" = "purge" ]; then
  # Nur die Konfigurationsdatei geht weg (wird beim nächsten Mal neu angelegt); Nutzerkonto
  # und /var/lib/anmachacast bleiben stehen, damit "apt purge && apt install" keine Sendedaten verliert.
  rm -f /etc/anmachacast/anmachacast.conf /etc/anmachacast/airdeck.conf
  rmdir /etc/anmachacast 2>/dev/null || true
fi

exit 0
