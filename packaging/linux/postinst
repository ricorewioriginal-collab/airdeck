#!/bin/sh
# AnMaCha Cast – nach der Installation: Dienstkonto anlegen, Ordner vorbereiten, systemd-Dienst starten.
set -e

if ! getent group anmachacast >/dev/null 2>&1; then
  addgroup --system anmachacast
fi
if ! getent passwd anmachacast >/dev/null 2>&1; then
  adduser --system --ingroup anmachacast --home /var/lib/anmachacast --no-create-home \
    --shell /usr/sbin/nologin --gecos "AnMaCha Cast Radio-Automation" anmachacast
fi

mkdir -p /etc/anmachacast /var/lib/anmachacast /var/log/anmachacast
# Eine anmachacast.conf muss vorhanden sein, bevor AnMaCha Cast zum ersten Mal startet – sonst würde es
# (ohne systemweite Konfiguration) im Home-Verzeichnis des Dienstkontos statt unter /var/lib/anmachacast
# ablegen (siehe resolveConfig() in src/server/config.ts). Den Rest trägt AnMaCha Cast selbst ein.
if [ ! -e /etc/anmachacast/anmachacast.conf ]; then
  printf '# AnMaCha Cast – wird beim ersten Start automatisch vervollständigt.\n# Siehe: man anmachacast-server, oder das Handbuch im Studio.\n' > /etc/anmachacast/anmachacast.conf
fi
chown -R anmachacast:anmachacast /etc/anmachacast /var/lib/anmachacast /var/log/anmachacast
chmod 750 /etc/anmachacast /var/lib/anmachacast /var/log/anmachacast

if [ -d /run/systemd/system ]; then
  systemctl daemon-reload || true
  systemctl enable anmachacast-server.service || true
  # Neuinstallation: gleich starten. Upgrade: neu starten, damit die neue Version läuft
  # ("configure" mit $2 gesetzt = vorherige Version war schon installiert).
  if [ "$1" = "configure" ]; then
    systemctl restart anmachacast-server.service || true
  fi
fi

exit 0
