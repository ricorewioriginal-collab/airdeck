# Falls der bestehende Webserver Caddy ist: diesen Block in den vorhandenen Caddyfile einfügen.
# AnMaCha Cast bleibt auf 8751, Icecast auf 8752 jeweils nur an 127.0.0.1 gebunden.
anmachacast-demo.ricorewi-radio.de {
	handle_path /stream/* {
		reverse_proxy 127.0.0.1:8752 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy 127.0.0.1:8751 {
			flush_interval -1
		}
	}
}
